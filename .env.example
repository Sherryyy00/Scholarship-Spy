# Copy this file to .env and fill in your own values. Never commit .env.

DJANGO_DEBUG=True
# Generate one with:
# python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://127.0.0.1:8000

# Leave blank to print emails (e.g. verification links) to the console.
# For Gmail, use an App Password, not your normal password.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Optional: switch database (defaults to SQLite)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=scholarship_spy
# DB_USER=
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Daily jobs (scrape + reminder emails) run automatically inside the web process.
# Leave on for a single server; set False if you run `python manage.py run_scheduler`
# as a separate worker or call `python manage.py run_jobs` from cron.
SCHEDULER_AUTOSTART=True
SCRAPE_AT=03:00
REMINDERS_AT=08:00
