# Copy this file to .env and fill in your own values. Never commit .env.

DJANGO_DEBUG=True
# Generate one with:
# python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://127.0.0.1:8000

# Leave blank to print emails (e.g. verification links) to the console.
# For Gmail, use an App Password, not your normal password.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Optional: switch database (defaults to SQLite)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=scholarship_spy
# DB_USER=
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Daily jobs (scrape + reminder emails) run automatically inside the web process.
# Leave on for a single server; set False if you run `python manage.py run_scheduler`
# as a separate worker or call `python manage.py run_jobs` from cron.
SCHEDULER_AUTOSTART=True
SCRAPE_AT=03:00
REMINDERS_AT=08:00

# --- Production security (only used when DJANGO_DEBUG=False) ---
# Admin at a secret path instead of /admin/
DJANGO_ADMIN_URL=admin/
# Full https origin(s) of the live site, comma separated
DJANGO_CSRF_TRUSTED_ORIGINS=
# Number of proxies in front of the app (Render/Railway: 1), for correct visitor IPs
TRUSTED_PROXY_COUNT=0
# HSTS: start at 86400 (1 day), raise to 31536000 once HTTPS works
DJANGO_HSTS_SECONDS=86400

# --- Hosting (see README > Deploying) ---
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
